# Copie para .env. Não compartilhe senhas nem publique esse arquivo.
APP_PATH=
APP_WORK_DIR=
APP_BACKEND=win32
# Expressão regular que identifica o título da janela principal.
APP_TITLE_RE=
UI_TIMEOUT=20
# Opcional: quando o módulo deve ser aberto por outro executável.
LAUNCHER_PATH=
LAUNCHER_TITLE_RE=
LAUNCHER_MENU_PATH=

# RH Metadados: credenciais somente no .env local.
RH_PATH=C:\meta\rhsis\rh.exe
RH_WORK_DIR=C:\meta\rhsis
RH_USER=
RH_PASSWORD=
RH_FREQUENCY_MENU=Módulos->Frequência
# Permite confirmar somente a janela TFrm_ConfiguracoesInvalidas.
RH_CONTINUE_INVALID_CONFIG=no

SQL_SERVER=
SQL_DATABASE=
SQL_DRIVER=ODBC Driver 18 for SQL Server
# windows: usa seu usuário Windows; sql: usa SQL_USER e SQL_PASSWORD.
SQL_AUTH=windows
SQL_USER=
SQL_PASSWORD=
SQL_ENCRYPT=yes
SQL_TRUST_CERTIFICATE=no
SQL_TIMEOUT=15

# Conta de TESTE para abertura automática da cópia do Acessus.
# Nunca publique o .env preenchido.
TESTE_USUARIO=
TESTE_SENHA=
